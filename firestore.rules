rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email in ['loyaltydesk0@gmail.com', 'behindyou358@gmail.com']);
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Meeting documents & subcollections for WebRTC signaling and participants
    match /meetings/{meetingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;

      // Real-time participant state
      match /participants/{participantId} {
        allow read, write: if true;
      }

      // Real-time WebRTC Signaling (offers, answers, ICE candidates)
      match /signals/{signalId} {
        allow read, write: if true;
      }

      // In-meeting Chat messages
      match /chat/{messageId} {
        allow read, write: if true;
      }

      // In-meeting live emoji reactions
      match /reactions/{reactionId} {
        allow read, write: if true;
      }
    }

    // Activity Logs for administrative platform monitoring
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // System Settings and maintenance controls
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contacts documents (Private to user)
    match /contacts/{contactId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // Direct 1:1 User-to-User Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantIds || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      // Messages in 1:1 conversation
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds || isAdmin());
        allow create: if isSignedIn() && ((request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds && request.resource.data.senderId == request.auth.uid) || isAdmin());
        allow update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds || isAdmin());
        allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Notifications documents
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() || true;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // General Chat messages
    match /chatMessages/{messageId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}


